{
  "name": "arkh-texturelab",
  "private": true,
  "version": "0.2.0",
  "description": "High-performance PBR texture authoring and channel packing workstation",
  "author": "ARKH LAB",
  "repository": {
    "type": "git",
    "url": "https://github.com/ixpeze/arkh_TextureLab.git"
  },
  "main": "dist-desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "build:desktop": "tsup ../desktop/main.ts ../desktop/preload.ts --format cjs --out-dir dist-desktop --external electron",
    "build": "tsc -b && vite build && npm run build:desktop",
    "lint": "oxlint",
    "test": "vitest run --exclude '**/e2e/**'",
    "test:e2e": "playwright test",
    "dist": "npm run build:icon && npm run build && electron-builder --config electron-builder.yml",
    "perf": "node scripts/perf/measure.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
