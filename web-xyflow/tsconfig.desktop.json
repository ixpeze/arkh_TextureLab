{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "electron": ["./node_modules/electron"]
    },
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "../desktop/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
